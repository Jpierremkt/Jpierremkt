{
  "name": "teleprompter-ai",
  "version": "0.1.0",
  "description": "Teleprompter profissional com IA para criadores de conteúdo",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "cd renderer && vite --host",
    "dev:electron": "cd electron && cross-env NODE_ENV=development wait-on http://localhost:5173 && electron -r ts-node/register ./main.ts",
    "seed:demo": "cd electron && ts-node -P ../tsconfig.main.json scripts/seedDemo.ts",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "cd renderer && vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "start": "electron .",
    "lint": "echo 'lint stub'"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "electron": "^28.3.0",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "styled-components": "^6.1.12",
    "uuid": "^9.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.5.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "wait-on": "^7.2.0"
  }
}
